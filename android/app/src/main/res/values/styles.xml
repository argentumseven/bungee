<resources>
    <style name="Theme.Bungee" parent="Theme.Bungee.Light" />
    <style name="Theme.Bungee.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F5F7FA</item>
        <item name="android:navigationBarColor">#F5F7FA</item>
        <item name="android:windowBackground">#F5F7FA</item>
        <item name="android:colorAccent">#2A6170</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Bungee.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#101720</item>
        <item name="android:navigationBarColor">#101720</item>
        <item name="android:windowBackground">#101720</item>
        <item name="android:colorAccent">#96C5CF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <string name="admin_description">Allow optional screen locking and eligible failed-credential callbacks. Camera capture requires separate local arming. No remote wipe or password changes. You can revoke access in Android settings.</string>
</resources>
