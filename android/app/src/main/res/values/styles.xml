<resources>
    <style name="Theme.Bungee" parent="Theme.Bungee.Light" />
    <style name="Theme.Bungee.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#FFF8FA</item>
        <item name="android:navigationBarColor">#FFF8FA</item>
        <item name="android:windowBackground">#FFF8FA</item>
        <item name="android:colorAccent">#C51353</item>
        <item name="android:windowActionModeOverlay">true</item>
