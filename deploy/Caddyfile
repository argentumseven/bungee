{
    admin off
    auto_https disable_redirects
    skip_install_trust
    default_sni {$BUNGEE_DOMAIN}
    servers {
        protocols h1 h2
    }
}
{$BUNGEE_DOMAIN} {
    tls internal {
        protocols tls1.3
        curves x25519mlkem768
    }
    encode zstd gzip
    @allowed remote_ip {$BUNGEE_ADMIN_SUBNETS:REQUIRED_ADMIN_SUBNETS}
    handle @allowed {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Bungee-Admin-IP {http.request.remote.host}
        }
    }
    handle {
        respond "Administrator network not allowed" 403
    }
}
http://127.0.0.1:8090 {
    bind 127.0.0.1
    respond /healthz "ready" 200
    respond 404
}
