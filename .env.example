# Reference Compose requires storage already provisioned by the host installer.
BUNGEE_STORAGE_ROOT=/opt/bungee
# Exact administrator HTTPS URL, including a nonstandard port.
BUNGEE_PUBLIC_ORIGIN=
BUNGEE_ADMIN_ADDRESS=127.0.0.1
BUNGEE_ADMIN_PORT=
# Required explicit administrator hosts/prefixes; no allow-everyone default.
BUNGEE_ADMIN_SUBNETS=
# Choose a custom UDP port, 1..65535 except 51820.
BUNGEE_WG_PORT=
# Reachable numeric IP:port; bracket IPv6. No endpoint DNS lookup.
BUNGEE_WG_ENDPOINT=
# Optional explicit LAN/home or public DNS resolver. Empty disables forwarding.
# Only this resolver's UDP/TCP port is allowed; no fallback or phone forwarding.
BUNGEE_DNS_UPSTREAM_IP=
BUNGEE_DNS_UPSTREAM_PORT=53
# Optional local offline map.mbtiles + geoip.mmdb, mounted read-only.
BUNGEE_GEODATA_DIR=./datasets
