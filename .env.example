# Dashboard address under your control. Caddy uses a LOCAL CA, never public ACME.
# Trust its root certificate explicitly on administrator devices (see deployment docs).
BUNGEE_DOMAIN=192.168.1.10
# Bind dashboard HTTPS to the server's LAN address, or leave loopback for an SSH tunnel.
BUNGEE_ADMIN_ADDRESS=127.0.0.1
# REQUIRED: choose your own unused UDP port, 1..65535, except 51820. No default.
BUNGEE_WG_PORT=
# Literal reachable IP:chosen-port. For IPv6 use [IP]:chosen-port. No provider DNS.
BUNGEE_WG_ENDPOINT=
# OPTIONAL managed DNS: your own private/LAN resolver. Empty disables the feature.
# Public provider IPs and the phone tunnel subnet are rejected; no provider default.
BUNGEE_DNS_UPSTREAM_IP=
BUNGEE_DNS_UPSTREAM_PORT=53
